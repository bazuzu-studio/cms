# ═════════════════════════════════════════════════════════════════════════════
# Payload CMS (apps/cms) — переменные окружения
#
# Локальная разработка: скопируйте в .env  (cp .env.example .env)
# Dokploy:              см. блок «PRODUCTION» внизу и docker-compose.yml
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# Приложение
# ─────────────────────────────────────────────

# PostgreSQL. Для docker-compose.dev.yml:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/movhub

# Секрет для подписи JWT/шифрования. Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Публичный URL самой CMS (Admin Panel + API) и URL(ы) frontend через запятую.
# Используются для serverURL, CORS и CSRF.
CMS_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Порт dev-сервера (dev-скрипт и так запускает next на 4000)
PORT=4000

# (необязательно) домен для auth-cookie, если frontend на другом поддомене
# должен видеть cookie CMS, например .otakuum.ru. По умолчанию — host-only.
# COOKIE_DOMAIN=


# ─────────────────────────────────────────────
# MinIO (локально поднимается docker-compose.dev.yml)
# ─────────────────────────────────────────────

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=supersecretpassword

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ─────────────────────────────────────────────
# S3 / Payload Storage
# ─────────────────────────────────────────────

S3_BUCKET=media

# Endpoint, к которому обращается СЕРВЕР CMS (в Dokploy — внутреннее имя сервиса)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=supersecretpassword

# URL, по которому БРАУЗЕР получает файлы (должен быть публичным и, в production, https)
S3_PUBLIC_URL=http://localhost:9000/media


# ═════════════════════════════════════════════
# PRODUCTION (Dokploy) — в Dokploy запускается только CMS; PostgreSQL и MinIO —
# отдельные сервисы проекта. Значения задаются во вкладке Environment.
# ═════════════════════════════════════════════
# DATABASE_URL=postgresql://postgres:<password>@<internal-host-БД>:5432/movhub
# PAYLOAD_SECRET=<openssl rand -hex 32>
# CMS_URL=https://cms.otakuum.ru
# FRONTEND_URL=https://otakuum.ru
# S3_BUCKET=media
# S3_ENDPOINT=http://<internal-host-minio>:9000     # внутренний адрес MinIO
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<ключ MinIO>
# S3_SECRET_ACCESS_KEY=<секрет MinIO>
# S3_PUBLIC_URL=https://<публичный-домен-minio>/media   # бакет должен быть публичным на чтение
