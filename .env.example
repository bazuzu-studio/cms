# ═════════════════════════════════════════════════════════════════════════════
# Payload CMS (apps/cms) — переменные окружения
#
# Локальная разработка: скопируйте в .env  (cp .env.example .env)
# Dokploy:              см. блок «PRODUCTION» внизу и docker-compose.yml
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# Приложение
# ─────────────────────────────────────────────

# PostgreSQL. Для docker-compose.dev.yml:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/movhub

# Секрет для подписи JWT/шифрования. Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Публичный URL самой CMS (Admin Panel + API) и URL(ы) frontend через запятую.
# Используются для serverURL, CORS и CSRF.
CMS_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Порт dev-сервера (dev-скрипт и так запускает next на 4000)
PORT=4000

# (необязательно) домен для auth-cookie, если frontend на другом поддомене
# должен видеть cookie CMS, например .otakuum.ru. По умолчанию — host-only.
# COOKIE_DOMAIN=


# ─────────────────────────────────────────────
# Email (сброс пароля, верификация новых пользователей и т.д.)
# Если SMTP_HOST не задан — email отключён, Payload только логирует
# предупреждение вместо реальной отправки (безопасно для dev).
# ─────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
# true только для порта 465 (implicit TLS); для 587/25 оставляйте false —
# STARTTLS поднимается автоматически.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

EMAIL_FROM_ADDRESS=no-reply@otakuum.ru
EMAIL_FROM_NAME=MovHub

# Куда падают сообщения из формы обратной связи apps/web
# (POST /api/contact-message, см. src/endpoints/contact-message.ts)
CONTACT_EMAIL_TO=


# ─────────────────────────────────────────────
# MinIO (локально поднимается docker-compose.dev.yml)
# ─────────────────────────────────────────────

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=supersecretpassword

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ─────────────────────────────────────────────
# S3 / Payload Storage
# ─────────────────────────────────────────────

S3_BUCKET=media

# Endpoint, к которому обращается СЕРВЕР CMS (в Dokploy — внутреннее имя сервиса)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=supersecretpassword

# URL, по которому БРАУЗЕР получает файлы (должен быть публичным и, в production, https)
S3_PUBLIC_URL=http://localhost:9000/media


# ═════════════════════════════════════════════
# PRODUCTION (Dokploy) — в Dokploy запускается только CMS; PostgreSQL и MinIO —
# отдельные сервисы проекта. Значения задаются во вкладке Environment.
# ═════════════════════════════════════════════
# DATABASE_URL=postgresql://postgres:<password>@<internal-host-БД>:5432/movhub
# PAYLOAD_SECRET=<openssl rand -hex 32>
# CMS_URL=https://cms.otakuum.ru
# FRONTEND_URL=https://otakuum.ru
# CMS и frontend — поддомены одного домена, поэтому COOKIE_DOMAIN обязателен:
# без него auth-cookie host-only на cms.otakuum.ru и не видна серверу
# фронтенда (middleware.ts для /profile, /favorites) — пользователей будет
# выкидывать на /login сразу после успешного входа. См. warning в src/lib/urls.ts.
# COOKIE_DOMAIN=.otakuum.ru
# SMTP_HOST=<хост SMTP-провайдера>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<логин SMTP>
# SMTP_PASS=<пароль/ключ SMTP>
# EMAIL_FROM_ADDRESS=no-reply@otakuum.ru
# EMAIL_FROM_NAME=MovHub
# CONTACT_EMAIL_TO=<ваш ящик для сообщений с /contact>
# S3_BUCKET=media
# S3_ENDPOINT=http://<internal-host-minio>:9000     # внутренний адрес MinIO
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<ключ MinIO>
# S3_SECRET_ACCESS_KEY=<секрет MinIO>
# S3_PUBLIC_URL=https://<публичный-домен-minio>/media   # бакет должен быть публичным на чтение

# ─────────────────────────────────────────────
# Безопасность и интеграция с фронтендом
# ─────────────────────────────────────────────

# Адрес фронтенда, доступный ИЗ контейнера CMS, и общий секрет: после правки
# контента CMS дёргает POST <REVALIDATE_URL>/api/revalidate, и сайт сразу
# обновляет кэш. Секрет должен совпадать с REVALIDATE_SECRET фронтенда
# (openssl rand -hex 32). Без обеих переменных — просто выключено.
# REVALIDATE_URL=http://localhost:3000
# REVALIDATE_SECRET=

# true — анонимы снова видят черновики (_status = 'draft'). Нужно только пока
# пайплайн не пишет _status = 'published' в новые записи.
# CONTENT_PUBLIC_DRAFTS=false

# true — включить GraphQL Playground и интроспекцию в production
# (нужно для `pnpm codegen` фронтенда против боевой схемы).
# GRAPHQL_INTROSPECTION=false

# Сколько доверенных прокси перед CMS (для rate-limit формы обратной связи):
# 1 = Traefik, 2 = Cloudflare → Traefik.
# TRUSTED_PROXY_HOPS=1
